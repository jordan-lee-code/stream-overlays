  "titleBits": {
    "type": "text",
    "label": "Cheerers board title",
    "value": "Top cheerers",
    "group": "Wording"
  },
  "titleTips": {
    "type": "text",
    "label": "Tippers board title",
    "value": "Top tippers",
    "group": "Wording"
  },
  "formatGifts": {
    "type": "text",
    "label": "How a gift total reads ({n} is the number)",
    "value": "{n} gifted",
    "group": "Wording"
  },
  "formatBits": {
    "type": "text",
    "label": "How a bits total reads ({n} is the number)",
    "value": "{n} bits",
    "group": "Wording"
  },
