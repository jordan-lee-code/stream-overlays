{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!leaderboard",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "mode": {
    "type": "dropdown",
    "label": "What to show",
    "value": "rotate",
    "options": {
      "rotate": "Rotate through the boards",
      "gifts": "Top gifters only",
      "bits": "Top cheerers only",
      "tips": "Top tippers only"
    },
    "group": "Board"
  },
  "rotateSeconds": {
    "type": "number",
