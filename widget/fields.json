{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!activity",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "layout": {
    "type": "dropdown",
    "label": "Layout",
    "value": "list",
