  "slot6": {
    "type": "text",
    "label": "Slot 6",
    "value": "",
    "group": "Schedule"
  },
  "slot7": {
    "type": "text",
    "label": "Slot 7",
    "value": "",
    "group": "Schedule"
  },
  "slot8": {
    "type": "text",
    "label": "Slot 8",
    "value": "",
    "group": "Schedule"
  },
  "slot9": {
    "type": "text",
    "label": "Slot 9",
    "value": "",
    "group": "Schedule"
  },
  "slot10": {
    "type": "text",
    "label": "Slot 10",
    "value": "",
    "group": "Schedule"
  },
  "note": {
    "type": "text",
    "label": "A line under the schedule, such as the time zone",
    "value": "",
    "group": "Schedule"
  },
  "highlightToday": {
    "type": "checkbox",
    "label": "Highlight today's slots, using the day's first three letters",
    "value": true,
    "group": "Schedule"
  },
  "textSize": {
    "type": "number",
    "label": "Text size (percent of the box width)",
    "value": 5,
    "min": 2,
    "max": 20,
    "step": 0.25,
    "group": "Size"
  },
  "titleScale": {
    "type": "number",
    "label": "Title size (share of the text size)",
    "value": 0.6,
    "min": 0.2,
    "max": 2,
    "step": 0.05,
    "group": "Size"
  },
  "itemGap": {
    "type": "number",
    "label": "Space between rows",
    "value": 0.4,
    "min": 0,
    "max": 2,
    "step": 0.05,
    "group": "Size"
  },
  "btnAdd": {
    "type": "button",
    "label": "Add a test task",
    "group": "Manual controls"
  },
  "btnNext": {
    "type": "button",
    "label": "Tick off the next task",
    "group": "Manual controls"
  },
  "btnClearDone": {
    "type": "button",
    "label": "Clear the ticked tasks",
    "group": "Manual controls"
  },
  "btnClearAll": {
    "type": "button",
    "label": "Clear every task",
    "group": "Manual controls"
  },
  "title": {
    "type": "text",
    "label": "Title for the task list",
    "value": "Today's tasks",
    "group": "Look"
  },
  "showTitle": {
    "type": "checkbox",
    "label": "Show the title",
    "value": true,
    "group": "Look"
  },
  "themePreset": {
    "type": "dropdown",
    "label": "Style preset (the same twenty-two are in every overlay in this set)",
    "value": "glass",
    "options": {
      "glass": "Soft black (default)",
      "frost": "Soft white",
      "midnight": "Midnight blue",
      "sunset": "Sunset",
      "forest": "Forest",
      "ocean": "Ocean",
      "rose": "Rose",
      "neon": "Neon",
      "cosycabin": "Cosy cabin",
      "pastel": "Cosy summer pastel",
      "celestial": "Celestial",
      "pastelgoth": "Pastel goth",
      "pastelpink": "Pastel pink",
      "pastelsage": "Pastel sage",
      "faegreen": "Fae green",
      "pride": "Rainbow pride",
      "trans": "Trans pride",
      "bi": "Bi pride",
      "pan": "Pan pride",
      "enby": "Non-binary pride",
      "lesbian": "Lesbian pride",
      "ace": "Ace pride",
      "custom": "Custom (use the colours below)"
    },
    "group": "Look"
  },
  "fontFamily": {
    "type": "googleFont",
    "label": "Font (used when the style preset is Custom)",
    "value": "BioRhyme",
    "group": "Look"
  },
  "weight": {
    "type": "number",
    "label": "Boldness (100 to 900)",
    "value": 800,
    "min": 100,
    "max": 900,
    "step": 100,
    "group": "Look"
  },
  "radius": {
    "type": "number",
    "label": "Corner roundness, in pixels",
    "value": 24,
    "min": 0,
    "max": 100,
    "step": 1,
    "group": "Look"
  },
  "pad": {
    "type": "number",
    "label": "Padding above and below",
    "value": 0.5,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "group": "Look"
  },
  "outerFrame": {
    "type": "checkbox",
    "label": "An outer frame round the widget in the accent colour, or the flag's stripes in a pride preset. Untick it for none",
    "value": true,
    "group": "Look"
  },
  "borderWidth": {
    "type": "number",
    "label": "Frame and outline thickness in pixels. At 0 the frame has a default thickness that grows with the box, and with the frame unticked there is no outline",
    "value": 0,
    "min": 0,
    "max": 20,
    "step": 1,
    "group": "Look"
  },
  "borderColor": {
    "type": "colorpicker",
    "label": "Outline colour, used when the outer frame is unticked and the thickness is above 0 (the frame itself is always the accent colour)",
    "value": "#FFFFFF",
    "group": "Look"
  },
  "shadow": {
    "type": "checkbox",
    "label": "Shadow",
    "value": false,
    "group": "Look"
  },
  "animate": {
    "type": "checkbox",
    "label": "Animate",
    "value": true,
    "group": "Look"
  },
  "fit": {
    "type": "checkbox",
    "label": "Shrink to fit the box: when the box is too short for everything, the whole card gets smaller instead of running off the bottom",
    "value": true,
    "group": "Look"
  },
  "colorPanel": {
    "type": "colorpicker",
    "label": "Panel colour (used when the style preset is Custom)",
    "value": "#000000",
    "group": "Custom colours"
  },
  "usePanelOpacity": {
    "type": "checkbox",
    "label": "Use the panel opacity below with the style preset too, not only with Custom",
    "value": false,
    "group": "Custom colours"
  },
  "panelOpacity": {
    "type": "number",
    "label": "Panel opacity, 0 to 1 (used when the style preset is Custom, or with any preset if the box above it is ticked)",
    "value": 0.55,
    "min": 0,
    "max": 1,
    "step": 0.05,
    "group": "Custom colours"
  },
  "cText": {
    "type": "colorpicker",
    "label": "Text (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cAccent": {
    "type": "colorpicker",
    "label": "Accent (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cTrack": {
    "type": "colorpicker",
    "label": "Bar and today's highlight (used when the style preset is Custom)",
    "value": "#444444",
    "group": "Custom colours"
  },
  "decoration": {
    "type": "dropdown",
    "label": "Decorations drawn behind the words, in the accent colour (or the flag's colours in a pride preset)",
    "value": "none",
    "options": {
      "none": "None",
      "sparkles": "Sparkles",
      "hearts": "Hearts",
      "stars": "Stars",
      "flowers": "Flowers",
      "moons": "Moons",
      "snowflakes": "Snowflakes",
      "bubbles": "Bubbles",
      "butterflies": "Butterflies",
      "clouds": "Clouds",
      "leaves": "Leaves",
      "paws": "Paw prints",
      "notes": "Music notes",
      "bows": "Bows",
      "mixed": "Sparkles, hearts and stars"
    },
    "group": "Decorations"
  },
  "decorationCount": {
    "type": "number",
    "label": "How many decorations (1 to 24)",
    "value": 8,
    "min": 1,
    "max": 24,
    "step": 1,
    "group": "Decorations"
  },
  "decorationSize": {
    "type": "number",
    "label": "Decoration size, as a multiple of the usual",
    "value": 1,
    "min": 0.3,
    "max": 4,
    "step": 0.1,
    "group": "Decorations"
  },
  "decorationMotion": {
    "type": "dropdown",
    "label": "How decorations move (with Animate off they stay still)",
    "value": "twinkle",
    "options": {
      "twinkle": "Twinkle in place",
      "drift": "Drift upwards and fade",
      "still": "Stay still"
    },
    "group": "Decorations"
  },
  "decorationPlacement": {
    "type": "dropdown",
    "label": "Where the decorations go",
    "value": "scatter",
    "options": {
      "scatter": "Scattered over the panel",
      "edges": "Along the inside of the edges",
      "corners": "In the corners",
      "offset": "A little way in from the corners (top right and bottom right first)",
      "border": "On the border, half outside it (leave a little room round the widget)"
    },
    "group": "Decorations"
  },
  "decorationColor": {
    "type": "dropdown",
    "label": "Decoration colour",
    "value": "accent",
    "options": {
      "accent": "The accent colour (a pride preset's flag colours)",
      "text": "The text colour",
      "mixed": "The accent and text colours, in turn",
      "custom": "The colour picked below"
    },
    "group": "Decorations"
  },
  "decorationTint": {
    "type": "colorpicker",
    "label": "Decoration colour to use when the colour above is the one picked here",
    "value": "#FFB6D9",
    "group": "Decorations"
  },
  "decorationOpacity": {
    "type": "number",
    "label": "Decoration opacity, 0.1 to 1 (separate from the panel's opacity, and 1 is fully solid). Twinkling dips a little and drifting fades in and out, so choose Stay still to keep them fully solid",
    "value": 0.5,
    "min": 0.1,
    "max": 1,
    "step": 0.05,
    "group": "Decorations"
  },
  "debug": {
    "type": "checkbox",
    "label": "Log every event to the browser-source console",
    "value": false,
    "group": "Troubleshooting"
  }
}
