    "group": "Schedule"
  },
  "slot4": {
    "type": "text",
    "label": "Slot 4",
    "value": "Sunday | 3pm | Cosy catch-up",
    "group": "Schedule"
  },
  "slot5": {
    "type": "text",
    "label": "Slot 5",
    "value": "",
    "group": "Schedule"
