{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!task",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "mode": {
    "type": "dropdown",
    "label": "What to show",
    "value": "tasks",
    "options": {
      "tasks": "A task list you change from chat",
      "schedule": "A schedule written in the settings below"
    },
    "group": "Mode"
  },
  "maxShown": {
    "type": "number",
    "label": "Tasks shown at once, then +N more",
    "value": 8,
    "min": 1,
    "max": 30,
    "step": 1,
    "group": "Tasks"
  },
  "maxTasks": {
    "type": "number",
    "label": "Most tasks that can be on the list",
    "value": 30,
    "min": 1,
    "max": 100,
    "step": 1,
    "group": "Tasks"
  },
  "hideDone": {
    "type": "checkbox",
    "label": "Hide a task once it is ticked off (its number still counts)",
    "value": false,
    "group": "Tasks"
  },
  "showNumbers": {
    "type": "checkbox",
    "label": "Show each task's number, which is what !task done 2 uses",
    "value": true,
    "group": "Tasks"
  },
  "showCount": {
    "type": "checkbox",
    "label": "Show how many are done, as 2 / 5",
    "value": true,
    "group": "Tasks"
  },
  "showBar": {
    "type": "checkbox",
    "label": "Show a bar that fills as tasks are done",
    "value": true,
    "group": "Tasks"
  },
  "allDoneText": {
    "type": "text",
    "label": "What the title says when every task is done (blank keeps the title)",
    "value": "All done, well done!",
    "group": "Tasks"
  },
  "hideWhenEmpty": {
    "type": "checkbox",
    "label": "Hide the whole widget while the list is empty",
    "value": true,
    "group": "Tasks"
  },
  "scheduleTitle": {
    "type": "text",
    "label": "Title for the schedule",
    "value": "This week",
    "group": "Schedule"
  },
  "slot1": {
    "type": "text",
    "label": "Slot 1: a day, a time and what is on, with vertical bars between (for example Monday | 7pm | Chill games)",
    "value": "Monday | 7pm | Chill games",
    "group": "Schedule"
  },
  "slot2": {
    "type": "text",
