[Unit]
Description=Two Truths and a Lie answer server
After=network.target

[Service]
# Change YOURNAME to the account that holds the folder, in all three places.
User=YOURNAME
WorkingDirectory=/home/YOURNAME/lie-server
ExecStart=/usr/bin/node /home/YOURNAME/lie-server/lie-server.js
# LIE_SECRET lives in this file, which only root can read.
EnvironmentFile=/etc/lie-server.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
