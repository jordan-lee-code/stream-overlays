{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!reminder",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "defaultText": {
    "type": "text",
    "label": "Text for a reminder set with no words (!reminder 15m)",
    "value": "Time's up",
    "group": "Reminders"
  },
  "snoozeTime": {
    "type": "text",
    "label": "Default snooze time (for example 5m)",
    "value": "5m",
    "group": "Reminders"
  },
  "maxShown": {
    "type": "number",
    "label": "Reminders shown at once, then +N more",
    "value": 3,
    "min": 1,
    "max": 10,
    "step": 1,
    "group": "Reminders"
  },
  "maxPending": {
    "type": "number",
    "label": "Most reminders that can be waiting at once",
    "value": 20,
    "min": 1,
    "max": 50,
    "step": 1,
    "group": "Reminders"
  },
  "repeatSeconds": {
    "type": "number",
    "label": "Play the sound again every this many seconds until cleared (0 for once)",
    "value": 0,
    "min": 0,
    "max": 3600,
    "step": 5,
    "group": "Reminders"
  },
  "showPending": {
    "type": "checkbox",
    "label": "Show a reminder as soon as it is set, with a countdown on the right (off shows it only once it is due)",
    "value": true,
    "group": "Reminders"
  },
  "dueText": {
    "type": "text",
    "label": "What the timer says when the countdown runs out",
    "value": "due",
    "group": "Reminders"
  },
  "pendingRows": {
    "type": "number",
    "label": "Waiting reminders shown",
    "value": 3,
    "min": 1,
    "max": 10,
    "step": 1,
    "group": "Reminders"
  },
  "textSize": {
    "type": "number",
    "label": "Reminder text size (percent of the box width)",
    "value": 7,
    "min": 2,
    "max": 20,
    "step": 0.25,
    "group": "Size"
  },
  "titleScale": {
    "type": "number",
    "label": "Title size (share of the text size)",
    "value": 0.55,
    "min": 0.2,
    "max": 2,
    "step": 0.05,
    "group": "Size"
  },
  "pendingScale": {
    "type": "number",
    "label": "Waiting-reminder size (share of the text size)",
    "value": 0.55,
    "min": 0.2,
    "max": 1.5,
    "step": 0.05,
    "group": "Size"
  },
  "itemGap": {
    "type": "number",
    "label": "Space between reminders",
    "value": 0.35,
    "min": 0,
    "max": 2,
    "step": 0.05,
    "group": "Size"
  },
  "pulse": {
    "type": "checkbox",
    "label": "Pulse the border while a reminder is showing, so it is hard to miss",
    "value": true,
    "group": "Size"
  },
  "btnTest": {
    "type": "button",
    "label": "Show a test reminder now",
    "group": "Manual controls"
  },
  "btnClear": {
    "type": "button",
    "label": "Clear the reminders that are showing",
    "group": "Manual controls"
  },
  "btnClearAll": {
    "type": "button",
    "label": "Clear everything, including the waiting ones",
    "group": "Manual controls"
  },
  "btnSnooze": {
    "type": "button",
    "label": "Snooze the reminders that are showing (default snooze time)",
    "group": "Manual controls"
  },
  "title": {
    "type": "text",
    "label": "Title",
    "value": "Reminder",
    "group": "Look"
  },
  "showTitle": {
    "type": "checkbox",
    "label": "Show the title",
    "value": true,
    "group": "Look"
  },
  "themePreset": {
    "type": "dropdown",
    "label": "Style preset (the same twenty-two are in every overlay in this set)",
    "value": "glass",
    "options": {
      "glass": "Soft black (default)",
      "frost": "Soft white",
      "midnight": "Midnight blue",
      "sunset": "Sunset",
      "forest": "Forest",
      "ocean": "Ocean",
      "rose": "Rose",
      "neon": "Neon",
      "cosycabin": "Cosy cabin",
      "pastel": "Cosy summer pastel",
      "celestial": "Celestial",
      "pastelgoth": "Pastel goth",
      "pastelpink": "Pastel pink",
      "pastelsage": "Pastel sage",
      "faegreen": "Fae green",
      "pride": "Rainbow pride",
      "trans": "Trans pride",
      "bi": "Bi pride",
      "pan": "Pan pride",
      "enby": "Non-binary pride",
      "lesbian": "Lesbian pride",
      "ace": "Ace pride",
      "custom": "Custom (use the colours below)"
    },
    "group": "Look"
  },
  "fontFamily": {
    "type": "googleFont",
    "label": "Font (used when the style preset is Custom)",
    "value": "BioRhyme",
    "group": "Look"
  },
  "weight": {
    "type": "number",
    "label": "Boldness (100 to 900)",
    "value": 800,
    "min": 100,
    "max": 900,
    "step": 100,
    "group": "Look"
  },
  "radius": {
    "type": "number",
    "label": "Corner roundness, in pixels",
    "value": 24,
    "min": 0,
    "max": 100,
    "step": 1,
    "group": "Look"
  },
  "pad": {
    "type": "number",
    "label": "Padding above and below",
    "value": 0.5,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "group": "Look"
  },
  "outerFrame": {
    "type": "checkbox",
    "label": "An outer frame round the widget in the accent colour, or the flag's stripes in a pride preset. Untick it for none",
    "value": true,
    "group": "Look"
  },
  "borderWidth": {
    "type": "number",
    "label": "Frame and outline thickness in pixels. At 0 the frame has a default thickness that grows with the box, and with the frame unticked there is no outline",
    "value": 0,
    "min": 0,
    "max": 20,
    "step": 1,
    "group": "Look"
  },
  "borderColor": {
    "type": "colorpicker",
    "label": "Outline colour, used when the outer frame is unticked and the thickness is above 0 (the frame itself is always the accent colour)",
    "value": "#FFFFFF",
    "group": "Look"
  },
  "shadow": {
    "type": "checkbox",
    "label": "Shadow",
    "value": false,
    "group": "Look"
  },
  "animate": {
    "type": "checkbox",
    "label": "Animate",
    "value": true,
    "group": "Look"
  },
  "fit": {
    "type": "checkbox",
    "label": "Shrink to fit the box: when the box is too short for everything, the whole card gets smaller instead of running off the bottom",
    "value": true,
    "group": "Look"
  },
  "colorPanel": {
    "type": "colorpicker",
    "label": "Panel colour (used when the style preset is Custom)",
    "value": "#000000",
    "group": "Custom colours"
  },
  "usePanelOpacity": {
    "type": "checkbox",
    "label": "Use the panel opacity below with the style preset too, not only with Custom",
    "value": false,
    "group": "Custom colours"
  },
  "panelOpacity": {
    "type": "number",
    "label": "Panel opacity, 0 to 1 (used when the style preset is Custom, or with any preset if the box above it is ticked)",
    "value": 0.55,
    "min": 0,
    "max": 1,
    "step": 0.05,
    "group": "Custom colours"
  },
  "cText": {
    "type": "colorpicker",
    "label": "Text (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cAccent": {
    "type": "colorpicker",
    "label": "Accent (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cTrack": {
    "type": "colorpicker",
    "label": "Bars and chips (used when the style preset is Custom)",
    "value": "#444444",
    "group": "Custom colours"
  },
  "cWarn": {
    "type": "colorpicker",
    "label": "Alert colour (used when the style preset is Custom)",
    "value": "#D64545",
    "group": "Custom colours"
  },
  "decoration": {
    "type": "dropdown",
    "label": "Decorations drawn behind the words, in the accent colour (or the flag's colours in a pride preset)",
    "value": "none",
    "options": {
      "none": "None",
      "sparkles": "Sparkles",
      "hearts": "Hearts",
      "stars": "Stars",
      "flowers": "Flowers",
      "moons": "Moons",
      "snowflakes": "Snowflakes",
      "bubbles": "Bubbles",
      "butterflies": "Butterflies",
      "clouds": "Clouds",
      "leaves": "Leaves",
      "paws": "Paw prints",
      "notes": "Music notes",
      "bows": "Bows",
      "mixed": "Sparkles, hearts and stars"
    },
    "group": "Decorations"
  },
  "decorationCount": {
    "type": "number",
    "label": "How many decorations (1 to 24)",
    "value": 8,
    "min": 1,
    "max": 24,
    "step": 1,
    "group": "Decorations"
  },
  "decorationSize": {
    "type": "number",
    "label": "Decoration size, as a multiple of the usual",
    "value": 1,
    "min": 0.3,
    "max": 4,
    "step": 0.1,
    "group": "Decorations"
  },
  "decorationMotion": {
    "type": "dropdown",
    "label": "How decorations move (with Animate off they stay still)",
    "value": "twinkle",
    "options": {
      "twinkle": "Twinkle in place",
      "drift": "Drift upwards and fade",
      "still": "Stay still"
    },
    "group": "Decorations"
  },
  "decorationPlacement": {
    "type": "dropdown",
    "label": "Where the decorations go",
    "value": "scatter",
    "options": {
      "scatter": "Scattered over the panel",
      "edges": "Along the inside of the edges",
      "corners": "In the corners",
      "offset": "A little way in from the corners (top right and bottom right first)",
      "border": "On the border, half outside it (leave a little room round the widget)"
    },
    "group": "Decorations"
  },
  "decorationColor": {
    "type": "dropdown",
    "label": "Decoration colour",
    "value": "accent",
    "options": {
      "accent": "The accent colour (a pride preset's flag colours)",
      "text": "The text colour",
      "mixed": "The accent and text colours, in turn",
      "custom": "The colour picked below"
    },
    "group": "Decorations"
  },
  "decorationTint": {
    "type": "colorpicker",
    "label": "Decoration colour to use when the colour above is the one picked here",
    "value": "#FFB6D9",
    "group": "Decorations"
  },
  "decorationOpacity": {
    "type": "number",
    "label": "How solid the decorations are, 0.1 to 1",
    "value": 0.5,
    "min": 0.1,
    "max": 1,
    "step": 0.05,
    "group": "Decorations"
  },
  "soundRemind": {
    "type": "sound-input",
    "label": "A reminder arrives",
    "value": "",
    "group": "Sounds"
  },
  "soundRemindVol": {
    "type": "number",
    "label": "Volume for that sound (0 to 100)",
    "value": 80,
    "min": 0,
    "max": 100,
    "step": 5,
    "group": "Sounds"
  },
  "test_soundRemind": {
    "type": "button",
    "label": "Test it",
    "group": "Sounds"
  },
  "mute": {
    "type": "checkbox",
    "label": "Mute every sound",
    "value": false,
    "group": "Sounds"
  },
  "debug": {
    "type": "checkbox",
    "label": "Log every event to the browser-source console",
    "value": false,
    "group": "Troubleshooting"
  }
}
