{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!donation",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "goal": {
    "type": "number",
    "label": "The goal, in your channel's currency",
    "value": 100,
    "group": "Goal",
    "min": 1,
    "step": 1
  },
  "startAmount": {
    "type": "number",
    "label": "Already raised when it starts, or starts again (use this to carry over money from before)",
    "value": 0,
    "group": "Goal",
    "min": 0,
    "step": 1
  },
  "whenReached": {
    "type": "dropdown",
    "label": "When the goal is reached",
    "value": "stay",
    "group": "Goal",
    "options": {
      "stay": "Stay full, with a message, until someone resets it",
      "stretch": "Raise the goal by the amount below and keep going"
    }
  },
  "stretchBy": {
    "type": "number",
    "label": "How much a stretched goal goes up each time",
    "value": 50,
    "group": "Goal",
    "min": 1,
    "step": 1
  },
  "minTip": {
    "type": "number",
    "label": "Smallest tip that counts (0 counts every tip)",
    "value": 0,
    "group": "Goal",
    "min": 0,
    "step": 0.5
  },
  "symbol": {
    "type": "text",
    "label": "Currency symbol (a blank shows none)",
    "value": "$",
    "group": "Money"
  },
  "symbolAfter": {
    "type": "checkbox",
    "label": "Put the symbol after the amount (5€ or 5 kr) instead of before it ($5)",
    "value": false,
    "group": "Money"
  },
  "decimalComma": {
    "type": "checkbox",
    "label": "Use a comma for the decimal (5,50) instead of a point (5.50)",
    "value": false,
    "group": "Money"
  },
  "decimals": {
    "type": "dropdown",
    "label": "Cents",
    "value": "auto",
    "group": "Money",
    "options": {
      "auto": "Only when there are some ($5 and $5.50)",
      "always": "Always ($5.00)",
      "none": "Never, rounded to a whole number ($6)"
    }
  },
  "showAmounts": {
    "type": "checkbox",
    "label": "Show the amount raised and the goal",
    "value": true,
    "group": "Display"
  },
  "showPercent": {
    "type": "checkbox",
    "label": "Show the percentage",
    "value": true,
    "group": "Display"
  },
  "showLatest": {
    "type": "checkbox",
    "label": "Show the latest donor",
    "value": true,
    "group": "Display"
  },
  "amountText": {
    "type": "text",
    "label": "The amounts. Use {raised}, {goal} and {percent}",
    "value": "{raised} of {goal}",
    "group": "Wording"
  },
  "percentText": {
    "type": "text",
    "label": "The percentage. Use {percent}",
    "value": "{percent}%",
    "group": "Wording"
  },
  "reachedText": {
    "type": "text",
    "label": "Shown when the goal is reached. Use {raised} and {goal} (the new goal, if it stretched)",
    "value": "Goal reached! Thank you",
    "group": "Wording"
  },
  "latestText": {
    "type": "text",
    "label": "The latest donor. Use {name} and {amount}",
    "value": "Latest: {name} gave {amount}",
    "group": "Wording"
  },
  "anonymousName": {
    "type": "text",
    "label": "Name shown for an anonymous donor",
    "value": "Anonymous",
    "group": "Wording"
  },
  "textSize": {
    "type": "number",
    "label": "Text size (percent of the box width)",
    "value": 6,
    "group": "Size",
    "min": 2,
    "max": 20,
    "step": 0.25
  },
  "barHeight": {
    "type": "number",
    "label": "Bar thickness, in text heights",
    "value": 0.9,
    "group": "Size",
    "min": 0.2,
    "max": 4,
    "step": 0.1
  },
  "titleScale": {
    "type": "number",
    "label": "Title size, as a multiple of the text size",
    "value": 1.2,
    "group": "Size",
    "min": 0.5,
    "max": 3,
    "step": 0.1
  },
  "title": {
    "type": "text",
    "label": "Title",
    "value": "Donation goal",
    "group": "Look"
  },
  "showTitle": {
    "type": "checkbox",
    "label": "Show the title",
    "value": true,
    "group": "Look"
  },
  "themePreset": {
    "type": "dropdown",
    "label": "Style preset (the same twenty-two are in every overlay in this set)",
    "value": "glass",
    "options": {
      "glass": "Soft black (default)",
      "frost": "Soft white",
      "midnight": "Midnight blue",
      "sunset": "Sunset",
      "forest": "Forest",
      "ocean": "Ocean",
      "rose": "Rose",
      "neon": "Neon",
      "cosycabin": "Cosy cabin",
      "pastel": "Cosy summer pastel",
      "celestial": "Celestial",
      "pastelgoth": "Pastel goth",
      "pastelpink": "Pastel pink",
      "pastelsage": "Pastel sage",
      "faegreen": "Fae green",
      "pride": "Rainbow pride",
      "trans": "Trans pride",
      "bi": "Bi pride",
      "pan": "Pan pride",
      "enby": "Non-binary pride",
      "lesbian": "Lesbian pride",
      "ace": "Ace pride",
      "custom": "Custom (use the colours below)"
    },
    "group": "Look"
  },
  "fontFamily": {
    "type": "googleFont",
    "label": "Font (used when the style preset is Custom)",
    "value": "BioRhyme",
    "group": "Look"
  },
  "weight": {
    "type": "number",
    "label": "Boldness (100 to 900)",
    "value": 800,
    "min": 100,
    "max": 900,
    "step": 100,
    "group": "Look"
  },
  "radius": {
    "type": "number",
    "label": "Corner roundness, in pixels",
    "value": 24,
    "min": 0,
    "max": 100,
    "step": 1,
    "group": "Look"
  },
  "pad": {
    "type": "number",
    "label": "Padding above and below",
    "value": 0.5,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "group": "Look"
  },
  "borderWidth": {
    "type": "number",
    "label": "Outline width, in pixels",
    "value": 0,
    "min": 0,
    "max": 20,
    "step": 1,
    "group": "Look"
  },
  "borderColor": {
    "type": "colorpicker",
    "label": "Outline colour",
    "value": "#FFFFFF",
    "group": "Look"
  },
  "shadow": {
    "type": "checkbox",
    "label": "Shadow",
    "value": false,
    "group": "Look"
  },
  "animate": {
    "type": "checkbox",
    "label": "Animate",
    "value": true,
    "group": "Look"
  },
  "colorPanel": {
    "type": "colorpicker",
    "label": "Panel colour (used when the style preset is Custom)",
    "value": "#000000",
    "group": "Custom colours"
  },
  "panelOpacity": {
    "type": "number",
    "label": "Panel opacity, 0 to 1 (used when the style preset is Custom)",
    "value": 0.55,
    "min": 0,
    "max": 1,
    "step": 0.05,
    "group": "Custom colours"
  },
  "cText": {
    "type": "colorpicker",
    "label": "Text (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cAccent": {
    "type": "colorpicker",
    "label": "Accent: the bar and the goal reached message (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cTrack": {
    "type": "colorpicker",
    "label": "The empty part of the bar (used when the style preset is Custom)",
    "value": "#444444",
    "group": "Custom colours"
  },
  "cWarn": {
    "type": "colorpicker",
    "label": "Alert colour (used when the style preset is Custom)",
    "value": "#D64545",
    "group": "Custom colours"
  },
  "btnDemo": {
    "type": "button",
    "label": "Add a test donation of 5",
    "group": "Manual controls"
  },
  "btnReset": {
    "type": "button",
    "label": "Start again (back to the starting amount and the goal in the settings)",
    "group": "Manual controls"
  },
  "mute": {
    "type": "checkbox",
    "label": "Mute every sound",
    "value": false,
    "group": "Sounds"
  },
  "soundTip": {
    "type": "sound-input",
    "label": "A donation arrives",
    "value": "",
    "group": "Sounds"
  },
  "soundTipVol": {
    "type": "number",
    "label": "Volume for that sound (0 to 100)",
    "value": 60,
    "group": "Sounds",
    "min": 0,
    "max": 100,
    "step": 5
  },
  "test_soundTip": {
    "type": "button",
    "label": "Test it",
    "group": "Sounds"
  },
  "soundReached": {
    "type": "sound-input",
    "label": "The goal is reached (plays instead of the donation sound)",
    "value": "",
    "group": "Sounds"
  },
  "soundReachedVol": {
    "type": "number",
    "label": "Volume for that sound (0 to 100)",
    "value": 70,
    "group": "Sounds",
    "min": 0,
    "max": 100,
    "step": 5
  },
  "test_soundReached": {
    "type": "button",
    "label": "Test it",
    "group": "Sounds"
  },
  "debug": {
    "type": "checkbox",
    "label": "Log every event to the browser-source console",
    "value": false,
    "group": "Troubleshooting"
  }
}
