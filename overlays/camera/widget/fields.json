{
  "command": {
    "type": "text",
    "label": "Command word. Moderators and you type it with off, on, brb [time], away [time] or cover <message>",
    "value": "!camera",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can cover and uncover the camera",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "startMode": {
    "type": "dropdown",
    "label": "Where it starts the very first time (after that it remembers where it was)",
    "value": "live",
    "group": "Safety",
    "options": {
      "live": "Camera showing",
      "off": "Camera covered"
    }
  },
  "holdWhileLoading": {
    "type": "checkbox",
    "label": "Stay covered until the saved state and the fonts have loaded, so a refresh of the browser source can never show the camera for a moment (recommended)",
    "value": true,
    "group": "Safety"
  },
  "autoReveal": {
    "type": "checkbox",
    "label": "When a brb or away countdown reaches zero, lift the cover by itself. Leave this off to keep the cover up until you say on, which is the safer choice",
    "value": false,
    "group": "Safety"
  },
  "offText": {
    "type": "text",
    "label": "Camera off: the message",
    "value": "Camera off",
    "group": "Wording"
  },
  "offSub": {
    "type": "text",
    "label": "Camera off: the smaller line under it",
    "value": "Back soon",
    "group": "Wording"
  },
  "brbText": {
    "type": "text",
    "label": "Be right back: the message",
    "value": "Be right back",
    "group": "Wording"
  },
  "awayText": {
    "type": "text",
    "label": "Away: the message",
    "value": "Away for a moment",
    "group": "Wording"
  },
  "timerText": {
    "type": "text",
    "label": "The countdown line. Use {time}",
    "value": "Back in {time}",
    "group": "Wording"
  },
  "overText": {
    "type": "text",
    "label": "What it says when a countdown reaches zero",
    "value": "Back any moment now",
    "group": "Wording"
  },
  "offIcon": {
    "type": "text",
    "label": "Camera off: an emoji or symbol above the message (blank for none)",
    "value": "🔒",
    "group": "Icons"
  },
  "brbIcon": {
    "type": "text",
    "label": "Be right back: the emoji or symbol",
    "value": "☕",
    "group": "Icons"
  },
  "awayIcon": {
    "type": "text",
    "label": "Away: the emoji or symbol",
    "value": "💤",
    "group": "Icons"
  },
  "coverIcon": {
    "type": "text",
    "label": "A message you set with cover: the emoji or symbol",
    "value": "",
    "group": "Icons"
  },
  "title": {
    "type": "text",
    "label": "Your name",
    "value": "Your name",
    "group": "Plate"
  },
  "showTitle": {
    "type": "checkbox",
    "label": "Show your name",
    "value": true,
    "group": "Plate"
  },
  "pronouns": {
    "type": "text",
    "label": "Your pronouns, such as she/her or they/them (blank shows none)",
    "value": "",
    "group": "Plate"
  },
  "showPronouns": {
    "type": "checkbox",
    "label": "Show your pronouns",
    "value": true,
    "group": "Plate"
  },
  "pronounStyle": {
    "type": "dropdown",
    "label": "How pronouns are written",
    "value": "tag",
    "group": "Plate",
    "options": {
      "tag": "A small tag",
      "brackets": "In brackets",
      "plain": "Plain text"
    }
  },
  "tagline": {
    "type": "text",
    "label": "A line under your name (blank shows none)",
    "value": "Welcome in",
    "group": "Plate"
  },
  "showTagline": {
    "type": "checkbox",
    "label": "Show the line under your name",
    "value": true,
    "group": "Plate"
  },
  "align": {
    "type": "dropdown",
    "label": "Where the text sits",
    "value": "center",
    "group": "Plate",
    "options": {
      "left": "On the left",
      "center": "In the middle",
      "right": "On the right"
    }
  },
  "platePosition": {
    "type": "dropdown",
    "label": "Where the nameplate goes, in relation to the camera window",
    "value": "below",
    "group": "Plate",
    "options": {
      "below": "Below the window",
      "above": "Above the window"
    }
  },
  "lines": {
    "type": "text",
    "label": "Lines that take turns underneath, separated by | (a vertical bar), for example your socials or a reminder",
    "value": "Thanks for being here | Drink some water | Be kind in chat",
    "group": "Rotating lines"
  },
  "showLines": {
    "type": "checkbox",
    "label": "Show the rotating lines",
    "value": true,
    "group": "Rotating lines"
  },
  "rotateSeconds": {
    "type": "number",
    "label": "Seconds each line stays",
    "value": 8,
    "group": "Rotating lines",
    "min": 2,
    "max": 600,
    "step": 1
  },
  "aspect": {
    "type": "dropdown",
    "label": "The window's shape. Free fills whatever room the nameplate leaves, so resize the box to resize it. A shape keeps that shape, centred in the box",
    "value": "free",
    "group": "Camera window",
    "options": {
      "free": "Free: it fills whatever room the box leaves, so resize the box to resize it",
      "16:9": "Widescreen, 16 by 9",
      "4:3": "Standard, 4 by 3",
      "3:2": "Photo, 3 by 2",
      "1:1": "Square",
      "9:16": "Portrait, 9 by 16"
    }
  },
  "shape": {
    "type": "dropdown",
    "label": "Shape of the window and its cover",
    "value": "rounded",
    "group": "Camera window",
    "options": {
      "rounded": "Rounded rectangle (the corner setting sets how round)",
      "circle": "Circle or oval, for a round camera"
    }
  },
  "showFrame": {
    "type": "checkbox",
    "label": "A frame around the window",
    "value": true,
    "group": "Frame"
  },
  "frameWidth": {
    "type": "number",
    "label": "How thick the frame is, as a percent of the window's width",
    "value": 1.5,
    "group": "Frame",
    "min": 0.2,
    "max": 10,
    "step": 0.1
  },
  "frameStyle": {
    "type": "dropdown",
    "label": "The frame's colour",
    "value": "preset",
    "group": "Frame",
    "options": {
      "preset": "The preset's: its accent colour, or its flag for a pride preset",
      "panel": "The preset's panel colour, made solid",
      "custom": "A colour you pick below"
    }
  },
  "colorFrame": {
    "type": "colorpicker",
    "label": "The frame's colour when you pick one",
    "value": "#FFFFFF",
    "group": "Frame"
  },
  "coverSize": {
    "type": "number",
    "label": "Cover text size, as a percent of the smaller side of the window",
    "value": 9,
    "group": "Size",
    "min": 2,
    "max": 30,
    "step": 0.5
  },
  "textSize": {
    "type": "number",
    "label": "Nameplate text size (percent of the box width)",
    "value": 5,
    "group": "Size",
    "min": 2,
    "max": 20,
    "step": 0.25
  },
  "titleScale": {
    "type": "number",
    "label": "Name size, as a multiple of the text size",
    "value": 1.5,
    "group": "Size",
    "min": 0.5,
    "max": 4,
    "step": 0.1
  },
  "rowGap": {
    "type": "number",
    "label": "Space between the lines, in text heights",
    "value": 0.3,
    "group": "Size",
    "min": 0,
    "max": 3,
    "step": 0.05
  },
  "themePreset": {
    "type": "dropdown",
    "label": "Style preset (the same twenty-two are in every overlay in this set)",
    "value": "glass",
    "options": {
      "glass": "Soft black (default)",
      "frost": "Soft white",
      "midnight": "Midnight blue",
      "sunset": "Sunset",
      "forest": "Forest",
      "ocean": "Ocean",
      "rose": "Rose",
      "neon": "Neon",
      "cosycabin": "Cosy cabin",
      "pastel": "Cosy summer pastel",
      "celestial": "Celestial",
      "pastelgoth": "Pastel goth",
      "pastelpink": "Pastel pink",
      "pastelsage": "Pastel sage",
      "faegreen": "Fae green",
      "pride": "Rainbow pride",
      "trans": "Trans pride",
      "bi": "Bi pride",
      "pan": "Pan pride",
      "enby": "Non-binary pride",
      "lesbian": "Lesbian pride",
      "ace": "Ace pride",
      "custom": "Custom (use the colours below)"
