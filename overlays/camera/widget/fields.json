    "value": 800,
    "min": 100,
    "max": 900,
    "step": 100,
    "group": "Look"
  },
  "radius": {
    "type": "number",
    "label": "Corner roundness, in pixels",
    "value": 24,
    "min": 0,
    "max": 100,
    "step": 1,
    "group": "Look"
  },
  "pad": {
    "type": "number",
