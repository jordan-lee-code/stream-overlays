{
  "title": {
    "type": "text",
    "label": "Your name",
    "value": "Your name",
    "group": "Plate"
  },
  "showTitle": {
    "type": "checkbox",
    "label": "Show your name",
    "value": true,
    "group": "Plate"
  },
  "pronouns": {
    "type": "text",
    "label": "Your pronouns, such as she/her or they/them (blank shows none)",
    "value": "",
    "group": "Plate"
  },
  "showPronouns": {
    "type": "checkbox",
    "label": "Show your pronouns",
    "value": true,
    "group": "Plate"
  },
  "pronounStyle": {
    "type": "dropdown",
    "label": "How pronouns are written",
    "value": "tag",
    "group": "Plate",
    "options": {
      "tag": "A small tag",
      "brackets": "In brackets",
      "plain": "Plain text"
    }
  },
  "tagline": {
    "type": "text",
    "label": "A line under your name (blank shows none)",
    "value": "Welcome in",
    "group": "Plate"
  },
  "showTagline": {
    "type": "checkbox",
    "label": "Show the line under your name",
    "value": true,
    "group": "Plate"
  },
  "align": {
    "type": "dropdown",
    "label": "Where the text sits",
    "value": "center",
    "group": "Plate",
    "options": {
      "left": "On the left",
      "center": "In the middle",
      "right": "On the right"
    }
  },
  "lines": {
    "type": "text",
    "label": "Lines that take turns underneath, separated by | (a vertical bar), for example your socials or a reminder",
    "value": "Thanks for being here | Drink some water | Be kind in chat",
    "group": "Rotating lines"
  },
  "showLines": {
    "type": "checkbox",
    "label": "Show the rotating lines",
    "value": true,
    "group": "Rotating lines"
  },
  "rotateSeconds": {
    "type": "number",
    "label": "Seconds each line stays",
    "value": 8,
    "group": "Rotating lines",
    "min": 2,
    "max": 600,
    "step": 1
  },
  "showWindow": {
    "type": "checkbox",
    "label": "Leave a window for the camera: this widget sits behind your webcam, and the window is where the camera shows (untick for the nameplate alone)",
    "value": true,
    "group": "Camera window"
  },
  "aspect": {
    "type": "dropdown",
    "label": "The window's shape",
    "value": "free",
    "group": "Camera window",
    "options": {
      "free": "Free: it fills whatever room the box leaves, so resize the box to resize it",
      "16:9": "Widescreen, 16 by 9",
      "4:3": "Standard, 4 by 3",
      "3:2": "Photo, 3 by 2",
      "1:1": "Square",
      "9:16": "Portrait, 9 by 16"
    }
  },
  "showFrame": {
    "type": "checkbox",
    "label": "A frame around the window",
    "value": true,
    "group": "Frame"
  },
  "frameWidth": {
    "type": "number",
    "label": "How thick the frame is, as a percent of the window's width",
    "value": 1.5,
    "group": "Frame",
    "min": 0.2,
    "max": 10,
    "step": 0.1
  },
  "frameStyle": {
    "type": "dropdown",
    "label": "The frame's colour",
    "value": "preset",
    "group": "Frame",
    "options": {
      "preset": "The preset's: its accent colour, or its flag for a pride preset",
      "panel": "The preset's panel colour, made solid",
      "custom": "A colour you pick below"
    }
  },
  "colorFrame": {
    "type": "colorpicker",
    "label": "The frame's colour when you pick one",
    "value": "#FFFFFF",
    "group": "Frame"
  },
  "textSize": {
    "type": "number",
    "label": "Text size (percent of the box width)",
    "value": 5,
    "group": "Size",
    "min": 2,
    "max": 20,
    "step": 0.25
  },
  "titleScale": {
    "type": "number",
    "label": "Name size, as a multiple of the text size",
    "value": 1.5,
    "group": "Size",
    "min": 0.5,
    "max": 4,
    "step": 0.1
  },
  "rowGap": {
    "type": "number",
    "label": "Space between the lines, in text heights",
    "value": 0.3,
    "group": "Size",
    "min": 0,
    "max": 3,
    "step": 0.05
  },
  "themePreset": {
    "type": "dropdown",
    "label": "Style preset (the same twenty-two are in every overlay in this set)",
    "value": "glass",
    "options": {
      "glass": "Soft black (default)",
      "frost": "Soft white",
      "midnight": "Midnight blue",
      "sunset": "Sunset",
      "forest": "Forest",
      "ocean": "Ocean",
      "rose": "Rose",
      "neon": "Neon",
      "cosycabin": "Cosy cabin",
      "pastel": "Cosy summer pastel",
      "celestial": "Celestial",
      "pastelgoth": "Pastel goth",
      "pastelpink": "Pastel pink",
      "pastelsage": "Pastel sage",
      "faegreen": "Fae green",
      "pride": "Rainbow pride",
      "trans": "Trans pride",
      "bi": "Bi pride",
      "pan": "Pan pride",
      "enby": "Non-binary pride",
      "lesbian": "Lesbian pride",
      "ace": "Ace pride",
      "custom": "Custom (use the colours below)"
    },
    "group": "Look"
  },
  "fontFamily": {
    "type": "googleFont",
    "label": "Font (used when the style preset is Custom)",
    "value": "BioRhyme",
    "group": "Look"
  },
  "weight": {
    "type": "number",
    "label": "Boldness (100 to 900)",
    "value": 800,
    "min": 100,
    "max": 900,
    "step": 100,
    "group": "Look"
  },
  "radius": {
    "type": "number",
    "label": "Corner roundness, in pixels",
    "value": 24,
    "min": 0,
    "max": 100,
    "step": 1,
    "group": "Look"
  },
  "pad": {
    "type": "number",
    "label": "Padding above and below",
    "value": 0.5,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "group": "Look"
  },
  "borderWidth": {
    "type": "number",
    "label": "Outline width, in pixels",
    "value": 0,
    "min": 0,
    "max": 20,
    "step": 1,
    "group": "Look"
  },
  "borderColor": {
    "type": "colorpicker",
    "label": "Outline colour",
    "value": "#FFFFFF",
    "group": "Look"
  },
  "shadow": {
    "type": "checkbox",
    "label": "Shadow",
    "value": false,
    "group": "Look"
  },
  "animate": {
    "type": "checkbox",
    "label": "Animate",
    "value": true,
    "group": "Look"
  },
  "fit": {
    "type": "checkbox",
    "label": "Shrink the nameplate to fit the box: when the box is too short for it, it gets smaller instead of running off the bottom, and leaves room for the window",
    "value": true,
    "group": "Look"
  },
  "colorPanel": {
    "type": "colorpicker",
    "label": "Panel colour (used when the style preset is Custom)",
    "value": "#000000",
    "group": "Custom colours"
  },
  "panelOpacity": {
    "type": "number",
    "label": "Panel opacity, 0 to 1 (used when the style preset is Custom)",
    "value": 0.55,
    "min": 0,
    "max": 1,
    "step": 0.05,
    "group": "Custom colours"
  },
  "cText": {
    "type": "colorpicker",
    "label": "Text (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cAccent": {
    "type": "colorpicker",
    "label": "Accent: the rotating line and the pronoun tag text (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cTrack": {
    "type": "colorpicker",
    "label": "The pronoun tag's background (used when the style preset is Custom)",
    "value": "#444444",
    "group": "Custom colours"
  },
  "debug": {
    "type": "checkbox",
    "label": "Log every event to the browser-source console",
    "value": false,
    "group": "Troubleshooting"
  }
}
