    "value": "!vote",
    "group": "Commands"
  },
  "endCommand": {
    "type": "text",
    "label": "End the poll early and declare",
    "value": "!voteend",
    "group": "Commands"
  },
  "cancelCommand": {
    "type": "text",
    "label": "Cancel the poll and declare nothing",
    "value": "!votecancel",
    "group": "Commands"
  },
  "restartCommand": {
    "type": "text",
    "label": "Run the same options again from scratch (chat wasn't ready)",
    "value": "!voterestart",
    "group": "Commands"
  },
  "extendCommand": {
    "type": "text",
