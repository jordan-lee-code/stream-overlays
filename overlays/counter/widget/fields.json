    "value": 1.5,
    "min": 0.5,
    "max": 10,
    "step": 0.5,
    "group": "Number"
  },
  "btnPlus": {
    "type": "button",
    "label": "Add one step",
    "group": "Manual controls"
  },
  "btnMinus": {
    "type": "button",
    "label": "Subtract one step",
    "group": "Manual controls"
  },
  "btnUndo": {
    "type": "button",
    "label": "Undo the last change",
    "group": "Manual controls"
  },
  "btnReset": {
    "type": "button",
    "label": "Reset to the starting value",
    "group": "Manual controls"
  },
  "btnLock": {
    "type": "button",
    "label": "Lock",
    "group": "Manual controls"
  },
  "btnUnlock": {
    "type": "button",
    "label": "Unlock",
    "group": "Manual controls"
  },
