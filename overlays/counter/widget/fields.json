{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!count",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "startCount": {
    "type": "number",
    "label": "Starting value (used the first time, and on Reset)",
    "value": 0,
    "step": 1,
    "group": "Counter"
  },
  "step": {
    "type": "number",
    "label": "Amount for a bare !count + or !count -",
    "value": 1,
    "min": 1,
    "max": 1000,
    "step": 1,
    "group": "Counter"
  },
  "allowNegative": {
    "type": "checkbox",
    "label": "Allow the count to go below zero",
    "value": false,
    "group": "Counter"
  },
  "maxCount": {
    "type": "number",
    "label": "Highest value (0 for no limit)",
    "value": 0,
    "min": 0,
    "step": 1,
    "group": "Counter"
  },
  "goal": {
    "type": "number",
    "label": "Goal (0 for none)",
    "value": 0,
    "min": 0,
    "step": 1,
    "group": "Counter"
  },
  "goalText": {
    "type": "text",
    "label": "Text when the goal is reached",
    "value": "Goal reached!",
    "group": "Counter"
  },
  "showGoal": {
    "type": "checkbox",
    "label": "Show the goal under the number",
    "value": true,
    "group": "Counter"
  },
  "showBar": {
    "type": "checkbox",
    "label": "Show a progress bar towards the goal",
    "value": true,
    "group": "Counter"
  },
  "milestoneEvery": {
    "type": "number",
    "label": "Celebrate every this many (0 for never)",
    "value": 0,
    "min": 0,
    "step": 1,
    "group": "Counter"
  },
  "milestoneText": {
    "type": "text",
    "label": "Milestone text",
    "value": "Milestone!",
    "group": "Counter"
  },
  "milestoneSeconds": {
    "type": "number",
    "label": "Seconds the milestone text stays",
    "value": 4,
    "min": 1,
    "max": 60,
    "step": 1,
    "group": "Counter"
  },
  "lockedText": {
    "type": "text",
    "label": "Text shown while locked",
    "value": "locked",
    "group": "Counter"
  },
  "prefix": {
    "type": "text",
    "label": "Text before the number",
    "value": "",
    "group": "Number"
  },
  "suffix": {
    "type": "text",
    "label": "Text after the number",
    "value": "",
    "group": "Number"
  },
  "digits": {
    "type": "number",
    "label": "Pad with zeros to this many digits (0 for none)",
    "value": 0,
    "min": 0,
    "max": 10,
    "step": 1,
    "group": "Number"
  },
  "layout": {
    "type": "dropdown",
    "label": "Layout",
    "value": "stacked",
    "options": {
      "stacked": "Title above the number",
      "inline": "Title beside the number"
    },
    "group": "Number"
  },
  "numberSize": {
    "type": "number",
    "label": "Number size (percent of the box width)",
    "value": 22,
    "min": 4,
    "max": 60,
    "step": 0.5,
    "group": "Number"
  },
  "titleScale": {
    "type": "number",
    "label": "Title size (share of the number size)",
    "value": 0.28,
    "min": 0.1,
    "max": 1,
    "step": 0.02,
    "group": "Number"
  },
  "goalScale": {
    "type": "number",
    "label": "Goal and note size (share of the number size)",
    "value": 0.22,
    "min": 0.08,
    "max": 0.8,
    "step": 0.01,
    "group": "Number"
  },
