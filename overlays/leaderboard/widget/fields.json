    "value": "#444444",
    "group": "Custom colours"
  },
  "cWarn": {
    "type": "colorpicker",
    "label": "Alert colour (used when the style preset is Custom)",
    "value": "#D64545",
    "group": "Custom colours"
  },
  "decoration": {
    "type": "dropdown",
    "label": "Decorations drawn behind the words, in the accent colour (or the flag's colours in a pride preset)",
    "value": "none",
    "options": {
      "none": "None",
      "sparkles": "Sparkles",
      "hearts": "Hearts",
      "stars": "Stars",
      "flowers": "Flowers",
      "moons": "Moons",
      "snowflakes": "Snowflakes",
      "bubbles": "Bubbles",
      "butterflies": "Butterflies",
      "clouds": "Clouds",
      "leaves": "Leaves",
      "paws": "Paw prints",
      "notes": "Music notes",
      "bows": "Bows",
      "mixed": "Sparkles, hearts and stars"
    },
    "group": "Decorations"
  },
  "decorationCount": {
    "type": "number",
