{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!leaderboard",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "mode": {
    "type": "dropdown",
    "label": "What to show",
    "value": "rotate",
    "options": {
      "rotate": "Rotate through the boards",
      "gifts": "Top gifters only",
      "bits": "Top cheerers only",
      "tips": "Top tippers only"
    },
    "group": "Board"
  },
  "rotateSeconds": {
    "type": "number",
    "label": "Seconds on each board when rotating",
    "value": 15,
    "min": 3,
    "max": 600,
    "step": 1,
    "group": "Board"
  },
  "rows": {
    "type": "number",
    "label": "Names shown",
    "value": 5,
    "min": 1,
    "max": 15,
    "step": 1,
    "group": "Board"
  },
  "showGifts": {
    "type": "checkbox",
    "label": "Include the gifters board when rotating",
    "value": true,
    "group": "Board"
  },
  "showBits": {
    "type": "checkbox",
    "label": "Include the cheerers board when rotating",
    "value": true,
    "group": "Board"
  },
  "showTips": {
    "type": "checkbox",
    "label": "Include the tippers board when rotating",
    "value": true,
    "group": "Board"
  },
  "anonymousGifts": {
    "type": "checkbox",
    "label": "Count anonymous gifters and cheerers together as Anonymous",
    "value": false,
    "group": "Board"
  },
  "ignoreNames": {
    "type": "text",
    "label": "Names to leave out, separated by commas (for example bots)",
    "value": "",
    "group": "Board"
  },
  "emptyText": {
    "type": "text",
    "label": "Text when a board is empty",
    "value": "No one yet",
    "group": "Board"
  },
  "titleGifts": {
    "type": "text",
    "label": "Gifters board title",
    "value": "Top gifters",
    "group": "Wording"
  },
  "titleBits": {
    "type": "text",
    "label": "Cheerers board title",
    "value": "Top cheerers",
    "group": "Wording"
  },
  "titleTips": {
    "type": "text",
    "label": "Tippers board title",
    "value": "Top tippers",
    "group": "Wording"
  },
  "formatGifts": {
    "type": "text",
    "label": "How a gift total reads ({n} is the number)",
    "value": "{n} gifted",
    "group": "Wording"
  },
  "formatBits": {
    "type": "text",
    "label": "How a bits total reads ({n} is the number)",
    "value": "{n} bits",
    "group": "Wording"
  },
  "formatTips": {
    "type": "text",
    "label": "How a tip total reads ({c} is the currency, {n} the amount)",
    "value": "{c}{n}",
    "group": "Wording"
  },
  "currency": {
    "type": "text",
    "label": "Currency symbol",
    "value": "\u00a3",
    "group": "Wording"
  },
  "showRank": {
    "type": "checkbox",
    "label": "Show rank numbers",
    "value": true,
    "group": "Rows"
  },
  "highlightFirst": {
    "type": "checkbox",
    "label": "Highlight first place with the accent colour",
    "value": true,
    "group": "Rows"
  },
  "maxName": {
    "type": "number",
    "label": "Longest name shown, in characters",
    "value": 16,
    "min": 4,
    "max": 40,
    "step": 1,
    "group": "Rows"
  },
  "rowSize": {
    "type": "number",
    "label": "Row text size (percent of the box width)",
    "value": 6,
    "min": 2,
    "max": 20,
    "step": 0.25,
    "group": "Rows"
  },
  "titleScale": {
    "type": "number",
    "label": "Title size (share of the row size)",
    "value": 1.15,
    "min": 0.5,
    "max": 3,
    "step": 0.05,
    "group": "Rows"
  },
  "rowGap": {
    "type": "number",
    "label": "Space between rows",
    "value": 0.25,
    "min": 0,
    "max": 2,
    "step": 0.05,
    "group": "Rows"
  },
  "highlightChange": {
    "type": "checkbox",
    "label": "Pop a row when its total changes",
    "value": true,
    "group": "Rows"
  },
  "btnNext": {
    "type": "button",
    "label": "Show the next board",
    "group": "Manual controls"
  },
  "btnRotate": {
    "type": "button",
    "label": "Go back to rotating",
    "group": "Manual controls"
  },
  "btnReset": {
    "type": "button",
    "label": "Clear every board",
    "group": "Manual controls"
  },
  "title": {
    "type": "text",
    "label": "Title above every board (leave empty to use each board's own title)",
    "value": "",
    "group": "Look"
  },
  "showTitle": {
    "type": "checkbox",
    "label": "Show the title",
    "value": true,
    "group": "Look"
  },
  "themePreset": {
    "type": "dropdown",
    "label": "Style preset (the same twenty-two are in every overlay in this set)",
    "value": "glass",
    "options": {
      "glass": "Soft black (default)",
      "textonly": "Text only (no box)",
      "frost": "Soft white",
      "midnight": "Midnight blue",
      "sunset": "Sunset",
      "forest": "Forest",
      "ocean": "Ocean",
      "rose": "Rose",
      "neon": "Neon",
      "cosycabin": "Cosy cabin",
      "pastel": "Cosy summer pastel",
      "celestial": "Celestial",
      "pastelgoth": "Pastel goth",
      "pastelpink": "Pastel pink",
      "pastelsage": "Pastel sage",
      "faegreen": "Fae green",
      "pride": "Rainbow pride",
      "trans": "Trans pride",
      "bi": "Bi pride",
      "pan": "Pan pride",
      "enby": "Non-binary pride",
      "lesbian": "Lesbian pride",
      "ace": "Ace pride",
      "custom": "Custom (use the colours below)"
    },
    "group": "Look"
  },
  "fontFamily": {
    "type": "googleFont",
    "label": "Font (used when the style preset is Custom)",
    "value": "BioRhyme",
    "group": "Look"
  },
  "weight": {
    "type": "number",
    "label": "Boldness (100 to 900)",
    "value": 800,
    "min": 100,
    "max": 900,
    "step": 100,
    "group": "Look"
  },
  "radius": {
    "type": "number",
    "label": "Corner roundness, in pixels",
    "value": 24,
    "min": 0,
    "max": 100,
    "step": 1,
    "group": "Look"
  },
  "pad": {
    "type": "number",
    "label": "Padding above and below",
    "value": 0.5,
    "min": 0,
    "max": 3,
    "step": 0.05,
    "group": "Look"
  },
  "outerFrame": {
    "type": "checkbox",
    "label": "An outer frame round the widget in the accent colour, or the flag's stripes in a pride preset. Untick it for none",
    "value": true,
    "group": "Look"
  },
  "borderWidth": {
    "type": "number",
    "label": "Frame and outline thickness in pixels. At 0 the frame has a default thickness that grows with the box, and with the frame unticked there is no outline",
    "value": 0,
    "min": 0,
    "max": 20,
    "step": 1,
    "group": "Look"
  },
  "borderColor": {
    "type": "colorpicker",
    "label": "Outline colour, used when the outer frame is unticked and the thickness is above 0 (the frame itself is always the accent colour)",
    "value": "#FFFFFF",
    "group": "Look"
  },
  "shadow": {
    "type": "checkbox",
    "label": "Shadow",
    "value": false,
    "group": "Look"
  },
  "animate": {
    "type": "checkbox",
    "label": "Animate",
    "value": true,
    "group": "Look"
  },
  "fit": {
    "type": "checkbox",
    "label": "Shrink to fit the box: when the box is too short for everything, the whole card gets smaller instead of running off the bottom",
    "value": true,
    "group": "Look"
  },
  "fillBox": {
    "type": "checkbox",
    "label": "Fill the height of the box: the panel is always as tall as the box you draw, with its content in the middle, so it stays put in OBS as things come and go (untick for a panel as tall as its content). If there is too much for the box, Shrink to fit makes it smaller",
    "value": true,
    "group": "Look"
  },
  "colorPanel": {
    "type": "colorpicker",
    "label": "Panel colour (used when the style preset is Custom)",
    "value": "#000000",
    "group": "Custom colours"
  },
  "usePanelOpacity": {
    "type": "checkbox",
    "label": "Use the panel opacity below with the style preset too, not only with Custom",
    "value": false,
    "group": "Custom colours"
  },
  "panelOpacity": {
    "type": "number",
    "label": "Panel opacity, 0 to 1 (used when the style preset is Custom, or with any preset if the box above it is ticked)",
    "value": 0.55,
    "min": 0,
    "max": 1,
    "step": 0.05,
    "group": "Custom colours"
  },
  "cText": {
    "type": "colorpicker",
    "label": "Text (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cAccent": {
    "type": "colorpicker",
    "label": "Accent (used when the style preset is Custom)",
    "value": "#FFFFFF",
    "group": "Custom colours"
  },
  "cTrack": {
    "type": "colorpicker",
