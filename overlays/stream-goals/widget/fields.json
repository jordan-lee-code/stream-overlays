    "value": 50,
    "min": 1,
    "step": 1,
    "group": "Subs goal"
  },
  "raiseSubs": {
    "type": "number",
    "label": "When it is reached, raise the goal by this much (0 to stop at the goal)",
    "value": 25,
    "min": 0,
    "step": 1,
    "group": "Subs goal"
  },
  "showBits": {
    "type": "checkbox",
