    },
    "group": "Commands"
  },
  "resetMode": {
    "type": "dropdown",
    "label": "When the goals start again",
    "value": "gap",
    "options": {
      "gap": "Automatically for a new stream (after a quiet gap)",
      "manual": "Only when I reset them",
      "load": "Every time the widget loads"
    },
    "group": "Resetting"
  },
  "gapHours": {
    "type": "number",
