{
  "command": {
    "type": "text",
    "label": "Command word",
    "value": "!goals",
    "group": "Commands"
  },
  "whoCanManage": {
    "type": "dropdown",
    "label": "Who can use it",
    "value": "mods",
    "options": {
      "broadcaster": "Broadcaster only",
      "mods": "Broadcaster + moderators"
    },
    "group": "Commands"
  },
  "resetMode": {
    "type": "dropdown",
    "label": "When the goals start again",
    "value": "gap",
    "options": {
      "gap": "Automatically for a new stream (after a quiet gap)",
      "manual": "Only when I reset them",
      "load": "Every time the widget loads"
    },
    "group": "Resetting"
  },
  "gapHours": {
    "type": "number",
    "label": "Hours of quiet that mean a new stream",
    "value": 6,
    "min": 1,
    "max": 72,
    "step": 0.5,
    "group": "Resetting"
  },
  "showSubs": {
    "type": "checkbox",
    "label": "Show the sub goal",
    "value": true,
    "group": "Subs goal"
  },
  "labelSubs": {
    "type": "text",
    "label": "Label",
    "value": "Sub goal",
    "group": "Subs goal"
  },
  "targetSubs": {
    "type": "number",
