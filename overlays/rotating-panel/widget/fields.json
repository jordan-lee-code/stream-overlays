    "group": "Look"
  },
  "shadow": {
    "type": "checkbox",
    "label": "Shadow",
    "value": false,
    "group": "Look"
  },
  "animate": {
    "type": "checkbox",
    "label": "Animate",
    "value": true,
    "group": "Look"
  },
  "fit": {
    "type": "checkbox",
