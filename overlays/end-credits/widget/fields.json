  "maxPerSection": {
    "type": "number",
    "label": "Most names in one list, then and N more",
    "value": 100,
    "min": 1,
    "max": 1000,
    "step": 1,
    "group": "Credits"
  },
  "ignore": {
    "type": "text",
    "label": "Names to leave out, separated by commas (bots, for example)",
    "value": "streamelements, nightbot, moobot, streamlabs, fossabot, wizebot",
    "group": "Credits"
  },
  "endLine": {
    "type": "text",
    "label": "Last line",
    "value": "See you next time",
    "group": "Credits"
  },
  "speed": {
    "type": "number",
    "label": "Roll speed (percent of the box height per second)",
    "value": 10,
    "min": 1,
    "max": 100,
    "step": 1,
    "group": "Roll"
  },
  "columns": {
    "type": "number",
    "label": "Columns of names",
    "value": 2,
    "min": 1,
    "max": 4,
    "step": 1,
    "group": "Roll"
  },
  "clearAfter": {
    "type": "checkbox",
    "label": "Start the lists again once the credits have rolled all the way through (otherwise use !credits reset)",
    "value": false,
    "group": "Roll"
  },
  "titleSize": {
    "type": "number",
    "label": "Title size, in units (a unit is a hundredth of the box width at 16 by 9)",
